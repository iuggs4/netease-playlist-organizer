{
  "manifest_version": 3,
  "name": "网易云红心歌单分类",
  "version": "0.4.1",
  "description": "按歌手整理网易云歌单，支持数量门槛和已有歌单配对。预览后追加，遇到限流显示冷却并安全重试。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://music.163.com/*", "http://music.163.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "网易云红心歌单分类"
  },
  "content_scripts": [
    {
      "matches": ["https://music.163.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["https://music.163.com/*"]
    }
  ]
}
