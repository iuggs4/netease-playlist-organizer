{
  "manifest_version": 3,
  "name": "网易云红心歌单分类",
  "version": "0.2.0",
  "description": "按歌手等维度分类网易云歌单，合唱多归属，歌手分类无需 AI。预览后追加到已有或新建歌单。",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://music.163.com/*", "http://music.163.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "网易云红心歌单分类"
  },
  "content_scripts": [
    {
      "matches": ["https://music.163.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["https://music.163.com/*"]
    }
  ]
}
