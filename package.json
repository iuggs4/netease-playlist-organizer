{
  "name": "netease-distribute-songs-tools",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "description": "把网易云歌单按歌手/情绪/曲风/语种/年代分类，歌手分类无需 AI",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "selftest": "esbuild --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/selftest.mjs tests/selftest.ts && node node_modules/.cache/selftest.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
